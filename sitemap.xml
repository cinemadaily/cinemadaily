---
layout: null
---

<?xml version="1.0" encoding="UTF-8"?>

<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

    <!-- MAIN PAGES -->

    <url>
        <loc>{{ '/' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/fa.html' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/news.html' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/film.html' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/tv.html' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/reviews.html' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/box-office.html' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/awards.html' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/trailers.html' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/features.html' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/people.html' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/search.html' | absolute_url }}</loc>
    </url>


    <!-- TRUST / COMPANY PAGES -->

    <url>
        <loc>{{ '/about.html' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/editorial.html' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/team.html' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/contact.html' | absolute_url }}</loc>
    </url>

    <url>
        <loc>{{ '/privacy.html' | absolute_url }}</loc>
    </url>


    <!-- ARTICLES -->

    {% assign sitemap_articles = site.articles | sort: "date" | reverse %}

    {% for article in sitemap_articles %}

    <url>

        <loc>{{ article.url | absolute_url }}</loc>

        {% if article.date %}
        <lastmod>{{ article.date | date_to_xmlschema }}</lastmod>
        {% endif %}

    </url>

    {% endfor %}


    <!-- PEOPLE -->

    {% assign sitemap_people = site.people | sort: "name" %}

    {% for person in sitemap_people %}

    <url>
        <loc>{{ person.url | absolute_url }}</loc>
    </url>

    {% endfor %}


</urlset>
